# Copy to .env and adjust. All values below are the local-dev defaults that match
# docker-compose.yml, so an empty .env already works after `docker compose up -d`.

# ── HTTP ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
# local | production. In production the process refuses to start with dev defaults.
APP_ENV=local

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# If host port 5432 is already taken (e.g. a native PostgreSQL service), start
# compose with POSTGRES_HOST_PORT=5433 and point DB_URL at that port.
# POSTGRES_HOST_PORT=5433
DB_URL=jdbc:postgresql://localhost:5432/romcatalog
DB_USER=romcatalog
DB_PASSWORD=romcatalog
DB_MAX_POOL_SIZE=5
DB_CONNECTION_TIMEOUT_MS=10000

# ── MinIO / object storage ───────────────────────────────────────────────────
# MINIO_ENDPOINT        : used by the API for control calls (statObject, putObject)
# MINIO_PUBLIC_ENDPOINT : used to SIGN download URLs; must be reachable by the phone.
#                         Defaults to MINIO_ENDPOINT when unset (fine for local dev).
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=roms
MINIO_REGION=us-east-1
STORAGE_TIMEOUT_MS=10000

# ── Download ─────────────────────────────────────────────────────────────────
# Lifetime of a presigned download URL, in seconds (default 900 = 15 min).
DOWNLOAD_URL_TTL_SECONDS=900

# ── Auth (JWT HS256 + accounts) ──────────────────────────────────────────────
# JWT_SECRET MUST be a strong random value before any real use. Without it the
# API signs/verifies with a well-known insecure default and logs a warning.
# JWT_SECRET=change-me-to-something-long-and-random
JWT_ISSUER=rom-catalog-api
JWT_AUDIENCE=rom-catalog-app
JWT_REALM=rom-catalog
JWT_TTL_HOURS=168          # login token lifetime (7 days)
BCRYPT_COST=12             # password hashing cost

# First-admin bootstrap: on boot, if no admin exists, an admin is created from
# these. Idempotent. Remove ADMIN_BOOTSTRAP_PASSWORD after the first successful boot.
# ADMIN_USERNAME=lucas
# ADMIN_BOOTSTRAP_PASSWORD=pick-a-strong-one
